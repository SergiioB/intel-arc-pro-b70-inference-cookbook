diff --git a/zig/src/xpu/fp64_bias_audit.zig b/zig/src/xpu/fp64_bias_audit.zig
new file mode 100644
index 000000000..afeb24b66
--- /dev/null
+++ b/zig/src/xpu/fp64_bias_audit.zig
@@ -0,0 +1,162 @@
+//! Exact BiasCorr zero-input and fused-SwiGLU production-oracle checks for the XPU FP64 probe.
+const std = @import("std");
+const q = @import("qwen27.zig");
+const fwd = @import("forward.zig");
+const freeze = @import("fp64_freeze.zig");
+const ze = q.ze;
+const Dev = q.Dev;
+const Acts = q.Acts;
+const Proj = q.Proj;
+const alloc = q.alloc;
+const NS = 24;
+
+fn readRow(d: *Dev, dst: []f16, src: *anyopaque, row: usize, n: usize) !void {
+    try ze.check(d.g.api.zeCommandListAppendMemoryCopy(d.list, dst.ptr, q.off(src, row * n * 2), n * 2, null, 0, null));
+}
+
+fn copyOutRows(d: *Dev, dst: []f16, src: *anyopaque, rows: []const usize, n: usize) !void {
+    for (rows, 0..) |r, i| try readRow(d, dst[i * n ..][0..n], src, r, n);
+}
+
+fn auditTagsEnabled() bool {
+    const v = std.c.getenv("XPU_BIASCORR_TAG_AUDIT") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+fn auditFp16Value(bits: u16) f32 {
+    const h: f16 = @bitCast(bits);
+    return @floatCast(h);
+}
+
+fn auditLogicalWidth(layer: usize, site: u32) usize {
+    return switch (site) {
+        0 => if (q.isAttention(layer)) 14336 else 16480,
+        2 => 34816,
+        1, 3 => 5120,
+        else => 0,
+    };
+}
+
+/// Deterministic exact-FP16 tags for the unique-index audit sidecar, in device column order.
+fn auditExpected(layer: usize, site: u32, c: usize) f32 {
+    if (c >= auditLogicalWidth(layer, site)) return 0;
+    var bits: u16 = undefined;
+    if (site == 2) {
+        const lane = c % 32;
+        const block = c / 32;
+        const ch = block * 16 + (lane % 16);
+        bits = @intCast(ch + 1);
+        if (lane >= 16) bits |= 0x8000;
+    } else {
+        bits = @intCast(c + 1);
+    }
+    return auditFp16Value(bits);
+}
+
+/// Zero-input audit: with x and both correction streams zero, every GEMM output element must be exactly fp16(bias[c]).
+pub fn zeroBiasCheck(d: *Dev, a: *Acts, w: Proj, bias: []const f32, layer: usize, site: u32) !void {
+    const N: usize = w.n;
+    const K: usize = w.k;
+    const sh = q.tpShape();
+    const h_cols: usize = @max(@as(usize, q.D), @max(@as(usize, sh.ff), @as(usize, sh.od)));
+    const corr_bytes = @as(usize, q.maxRows()) * fwd.gStride(h_cols / 64) * 2;
+    const zx = try d.g.deviceAlloc(@as(usize, q.maxRows()) * K * 2);
+    defer d.g.free(zx);
+    const zhi = try d.g.deviceAlloc(corr_bytes);
+    defer d.g.free(zhi);
+    const zlo = try d.g.deviceAlloc(corr_bytes);
+    defer d.g.free(zlo);
+    try d.fill(zx, @as(u16, 0), @as(usize, q.maxRows()) * K * 2);
+    try d.fill(zhi, @as(u16, 0), corr_bytes);
+    try d.fill(zlo, @as(u16, 0), corr_bytes);
+    const scratch = try d.g.deviceAlloc(@as(usize, NS) * N * 2);
+    defer d.g.free(scratch);
+    var bad: usize = 0;
+    var total: usize = 0;
+    var fp32_exact: usize = 0;
+    const tag_audit = auditTagsEnabled();
+    for ([_]u32{ 1, 8, NS }, 0..) |m, pi| {
+        try fwd.gemmRows(d, a.pscr, zx, zhi, zlo, w, scratch, m, m > 16);
+        try d.sync();
+        const got = try alloc.alloc(f16, N);
+        defer alloc.free(got);
+        try readRow(d, got, scratch, 0, N);
+        try d.sync();
+        for (0..N) |c| {
+            const want32 = if (tag_audit) auditExpected(layer, site, c) else bias[c];
+            const want: f16 = @floatCast(want32);
+            total += 1;
+            const got_bits = @as(u16, @bitCast(got[c]));
+            if (got_bits == @as(u16, @bitCast(want))) {
+                const got32: f32 = @floatCast(got[c]);
+                if (got32 == want32) fp32_exact += 1 else if (tag_audit) bad += 1;
+            } else bad += 1;
+        }
+        if (bad != 0 and pi == 2) break;
+    }
+    std.debug.print("fp64 ref: zero-input exact fp16(bias) audit: {d}/{d} exact ({d} mismatches), direct fp32 exact {d}/{d}\n", .{ total - bad, total, bad, fp32_exact, total });
+    if (bad != 0) return error.BiasCorrZeroInputMismatch;
+}
+
+fn swigluMaxRelL2() !f64 {
+    const v = std.c.getenv("XPU_FP64_SWIGLU_MAX_REL_L2") orelse return 5.0e-3;
+    const bound = std.fmt.parseFloat(f64, std.mem.span(v)) catch return error.BadSwigluRelL2Bound;
+    if (!std.math.isFinite(bound) or bound <= 0.0) return error.BadSwigluRelL2Bound;
+    return bound;
+}
+
+/// Compare the production fused SwiGLU kernel with the independent FP64 gate/up reference (including logical bias).
+pub fn fusedSwigluCheck(d: *Dev, a: *Acts, w: Proj, T: u32, rows: []const usize, ref: []const f64, replay: ?freeze.Replay) !void {
+    if (!w.ilv or !w.wide or fwd.gemm_hook != null) return error.FusedSwigluPathNotRun;
+    const xb = @as(usize, T) * q.D * 2;
+    const cb = freeze.corrBytes();
+    const bx = try d.g.deviceAlloc(xb);
+    defer d.g.free(bx);
+    const bhi = try d.g.deviceAlloc(cb);
+    defer d.g.free(bhi);
+    const blo = try d.g.deviceAlloc(cb);
+    defer d.g.free(blo);
+    try q.copy(d, bx, a.h, xb);
+    try q.copy(d, bhi, a.ahi, cb);
+    try q.copy(d, blo, a.alo, cb);
+    if (replay) |rr| {
+        try q.copy(d, a.h, rr.x, xb);
+        try q.copy(d, a.ahi, rr.hi, cb);
+        try q.copy(d, a.alo, rr.lo, cb);
+    }
+    const outdev = try fwd.mlpIn(d, a, w, T, @intCast(q.GS), false, true);
+    try q.copy(d, a.h, bx, xb);
+    try q.copy(d, a.ahi, bhi, cb);
+    try q.copy(d, a.alo, blo, cb);
+    if (outdev != a.p) return error.FusedSwigluPathNotRun;
+    try d.sync();
+    const F: usize = w.n / 2;
+    const got = try alloc.alloc(f16, rows.len * F);
+    defer alloc.free(got);
+    try copyOutRows(d, got, outdev, rows, F);
+    try d.sync();
+    var se: f64 = 0;
+    var sr: f64 = 0;
+    var ma: f64 = 0;
+    for (0..rows.len) |r| {
+        for (0..F) |c| {
+            const gc = (c / 16) * 32 + c % 16;
+            const uc = gc + 16;
+            const g = ref[r * w.n + gc];
+            const u = ref[r * w.n + uc];
+            const expect = g / (1 + @exp(-g)) * u;
+            const got64: f64 = @floatCast(got[r * F + c]);
+            if (!std.math.isFinite(got64)) return error.NonFiniteFusedSwigluOutput;
+            if (!std.math.isFinite(expect)) return error.NonFiniteSwigluOracle;
+            const e = got64 - expect;
+            se += e * e;
+            sr += expect * expect;
+            ma = @max(ma, @abs(e));
+        }
+    }
+    var rel: f64 = std.math.inf(f64);
+    if (sr != 0) rel = @sqrt(se / sr) else if (se == 0) rel = 0;
+    const bound = try swigluMaxRelL2();
+    std.debug.print("fp64 ref: fused SwiGLU production output vs independent FP64 oracle: rel L2 {e:.2}, max abs {e:.2}, bound {e:.2}\n", .{ rel, ma, bound });
+    if (!std.math.isFinite(rel) or rel > bound) return error.FusedSwigluOracleMismatch;
+}
diff --git a/zig/src/xpu/fp64_bias_oracle.zig b/zig/src/xpu/fp64_bias_oracle.zig
new file mode 100644
index 000000000..2d41f51af
--- /dev/null
+++ b/zig/src/xpu/fp64_bias_oracle.zig
@@ -0,0 +1,128 @@
+//! Independent host BiasCorr oracle: logical sidecar keys, never the device's assembled bias buffer.
+const std = @import("std");
+const q = @import("qwen27.zig");
+const alloc = q.alloc;
+
+fn canonical(name: []const u8) []const u8 {
+    if (std.mem.startsWith(u8, name, "language_model.")) return name["language_model.".len..];
+    if (std.mem.startsWith(u8, name, "model.language_model.")) return name["model.language_model.".len..];
+    return name;
+}
+
+fn strictMode() bool {
+    const v = std.c.getenv("XPU_BIASCORR_FILE") orelse return false;
+    if (std.mem.span(v).len == 0) return false;
+    const partial = std.c.getenv("XPU_BIASCORR_ALLOW_PARTIAL") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(partial), "1");
+}
+
+fn vector(c: *const q.Checkpoint, sidecar_start: usize, comptime fmt: []const u8, args: anytype) !?[]const u8 {
+    var buf: [256]u8 = undefined;
+    const want = std.fmt.bufPrint(&buf, fmt, args) catch return error.BadBiasCorrOracle;
+    if (sidecar_start == std.math.maxInt(usize) or sidecar_start > c.tensors.items.len) return null;
+    for (c.tensors.items[sidecar_start..]) |t| {
+        if (!std.mem.eql(u8, canonical(t.name), want)) continue;
+        if (!std.mem.eql(u8, t.dtype, "F32") or t.rank != 1 or t.bytes.len != @as(usize, @intCast(t.shape[0])) * 4) return error.BadBiasCorrVector;
+        for (0..@as(usize, @intCast(t.shape[0]))) |i| {
+            const v: f32 = @bitCast(std.mem.readInt(u32, t.bytes[4 * i ..][0..4], .little));
+            if (!std.math.isFinite(v)) return error.NonFiniteBiasCorr;
+        }
+        return t.bytes;
+    }
+    return null;
+}
+
+fn f32at(bytes: []const u8, i: usize) f32 {
+    return @bitCast(std.mem.readInt(u32, bytes[4 * i ..][0..4], .little));
+}
+
+fn copyMember(dst: []f32, dst0: usize, src: ?[]const u8, src0: usize, len: usize) void {
+    const b = src orelse return;
+    for (0..len) |i| dst[dst0 + i] = f32at(b, src0 + i);
+}
+
+fn member(c: *const q.Checkpoint, sidecar_start: usize, layer: usize, comptime leaf: []const u8) !?[]const u8 {
+    return vector(c, sidecar_start, "model.layers.{d}." ++ leaf ++ ".bias_corr", .{layer});
+}
+
+fn need(found: ?[]const u8, comptime leaf: []const u8, layer: usize) !?[]const u8 {
+    if (found == null and strictMode()) {
+        std.debug.print("missing expected biascorr member: model.layers.{d}." ++ leaf ++ ".bias_corr\n", .{layer});
+        return error.MissingBiasCorrMember;
+    }
+    return found;
+}
+
+/// Logical bias in this rank's device column order; probes run on rank 0.
+pub fn assemble(c: *const q.Checkpoint, layer: usize, site: u32, n: usize, sidecar_start: usize) !?[]f32 {
+    if (site == 4 or std.c.getenv("XPU_BIASCORR_FILE") == null) return null;
+    const out = try alloc.alloc(f32, n);
+    @memset(out, 0);
+    var used = false;
+    const tp = q.TP;
+    if (site == 2) { // mlp gate|up, device-interleaved in blocks of 16
+        const full = q.FF;
+        const local = full / tp;
+        const gate = try need(try member(c, sidecar_start, layer, "mlp.gate_proj"), "mlp.gate_proj", layer);
+        const up = try need(try member(c, sidecar_start, layer, "mlp.up_proj"), "mlp.up_proj", layer);
+        used = gate != null or up != null;
+        for (0..local) |i| {
+            const col0 = (i / 16) * 32 + i % 16;
+            if (gate) |b| out[col0] = f32at(b, i); // rank 0 logical slice
+            if (up) |b| out[col0 + 16] = f32at(b, i);
+        }
+    } else if (site == 3) {
+        used = try copyDense(c, sidecar_start, layer, "mlp.down_proj", out, 0, n);
+    } else if (site == 1) {
+        used = if (q.isAttention(layer)) try copyDense(c, sidecar_start, layer, "self_attn.o_proj", out, 0, n) else try copyDense(c, sidecar_start, layer, "linear_attn.out_proj", out, 0, n);
+    } else if (q.isAttention(layer)) { // q,k,v concatenated column-parallel members
+        const qfull: usize = 24 * 512;
+        const kvfull: usize = 4 * 256;
+        const ql = qfull / tp;
+        const kl = kvfull / tp;
+        const qq = try need(try member(c, sidecar_start, layer, "self_attn.q_proj"), "self_attn.q_proj", layer);
+        const kk = try need(try member(c, sidecar_start, layer, "self_attn.k_proj"), "self_attn.k_proj", layer);
+        const vv = try need(try member(c, sidecar_start, layer, "self_attn.v_proj"), "self_attn.v_proj", layer);
+        used = qq != null or kk != null or vv != null;
+        copyMember(out, 0, qq, 0, ql);
+        copyMember(out, ql, kk, 0, kl);
+        copyMember(out, ql + kl, vv, 0, kl);
+    } else { // GDN logical q|k|v inside in_proj_qkv, then z,a,b concatenated
+        const qfull: usize = 16 * 128;
+        const kfull: usize = 16 * 128;
+        const vfull: usize = 48 * 128;
+        const ql = qfull / tp;
+        const kl = kfull / tp;
+        const vl = vfull / tp;
+        const zl = vfull / tp;
+        const al = 48 / tp;
+        const qkv = try need(try member(c, sidecar_start, layer, "linear_attn.in_proj_qkv"), "linear_attn.in_proj_qkv", layer);
+        const zz = try need(try member(c, sidecar_start, layer, "linear_attn.in_proj_z"), "linear_attn.in_proj_z", layer);
+        const aa = try need(try member(c, sidecar_start, layer, "linear_attn.in_proj_a"), "linear_attn.in_proj_a", layer);
+        const bb = try need(try member(c, sidecar_start, layer, "linear_attn.in_proj_b"), "linear_attn.in_proj_b", layer);
+        used = qkv != null or zz != null or aa != null or bb != null;
+        var at: usize = 0;
+        copyMember(out, at, qkv, 0, ql);
+        at += ql;
+        copyMember(out, at, qkv, qfull, kl);
+        at += kl;
+        copyMember(out, at, qkv, qfull + kfull, vl);
+        at += vl;
+        copyMember(out, at, zz, 0, zl);
+        at += zl;
+        copyMember(out, at, aa, 0, al);
+        at += al;
+        copyMember(out, at, bb, 0, al);
+    }
+    if (!used) {
+        alloc.free(out);
+        return null;
+    }
+    return out;
+}
+
+fn copyDense(c: *const q.Checkpoint, sidecar_start: usize, layer: usize, comptime leaf: []const u8, out: []f32, at: usize, n: usize) !bool {
+    const b = try need(try member(c, sidecar_start, layer, leaf), leaf, layer) orelse return false;
+    copyMember(out, at, b, 0, @min(n, b.len / 4));
+    return true;
+}
diff --git a/zig/src/xpu/fp64_fidelity.zig b/zig/src/xpu/fp64_fidelity.zig
new file mode 100644
index 000000000..dcc9fe301
--- /dev/null
+++ b/zig/src/xpu/fp64_fidelity.zig
@@ -0,0 +1,181 @@
+//! Teacher-forced top-token fidelity with FP64 GEMM replacement (XPU_FIDELITY), runner only.
+const std = @import("std");
+const q = @import("qwen27.zig");
+const fwd = @import("forward.zig");
+const fp64 = @import("fp64_ref.zig");
+const bias_oracle = @import("fp64_bias_oracle.zig");
+const ze = q.ze;
+const Dev = q.Dev;
+const Proj = q.Proj;
+const alloc = q.alloc;
+extern "c" fn memfd_create(name: [*:0]const u8, flags: c_uint) c_int;
+extern "c" fn pread(fd: c_int, buf: [*]u8, n: usize, off: i64) isize;
+extern "c" fn close(fd: c_int) c_int;
+extern "c" fn open(path: [*:0]const u8, flags: c_int, ...) c_int;
+extern "c" fn write(fd: c_int, buf: [*]const u8, n: usize) isize;
+
+var runner: *q.Runner = undefined;
+
+fn addReferenceBias(layer: usize, site: u32, ref: []f64, m: usize, n: usize) !void {
+    const bias = try bias_oracle.assemble(&runner.ckpt, layer, site, n, runner.model.biascorr_start);
+    if (bias) |b| {
+        defer alloc.free(b);
+        for (0..m) |row| {
+            for (0..n) |c| ref[row * n + c] += b[c];
+        }
+    }
+}
+
+// ---------------------------------------------------------------- teacher-forced fidelity
+
+/// The FP64 forward's GEMMs: each XPU GEMM output replaced by fp16(FP64) of the same int4 weights and input rows.
+fn replace(d: *Dev, h: *anyopaque, w: Proj, out: *anyopaque, m: u32) !void {
+    const r = runner;
+    var layer: usize = q.LAYERS;
+    var site: u32 = 4;
+    for (&r.model.layers, 0..) |*l, i| {
+        for ([_]Proj{ l.mixer_in, l.mixer_out, l.gu, l.down }, 0..) |p, si| if (p.w == w.w) {
+            layer = i;
+            site = @intCast(si);
+        };
+    }
+    if (site == 4 and w.w != r.model.head.w) return error.UnknownProjection;
+    try d.sync();
+    const K: usize = w.k;
+    const N: usize = w.n;
+    const xh = try alloc.alloc(f16, m * K);
+    defer alloc.free(xh);
+    const o = try alloc.alloc(f16, m * N);
+    defer alloc.free(o);
+    try ze.check(d.g.api.zeCommandListAppendMemoryCopy(d.list, xh.ptr, h, xh.len * 2, null, 0, null));
+    try ze.check(d.g.api.zeCommandListAppendMemoryCopy(d.list, o.ptr, out, o.len * 2, null, 0, null));
+    try d.sync();
+    const ps = try fp64.parts(&r.ckpt, w, layer, site);
+    const ref = try alloc.alloc(f64, m * N);
+    defer alloc.free(ref);
+    try fp64.hostGemm(ps, xh, m, N, ref, &.{});
+    try addReferenceBias(layer, site, ref, m, N);
+    for (ps) |*p| for (0..p.n) |n| {
+        const c = p.col(n);
+        for (0..m) |s| o[s * N + c] = @floatCast(ref[s * N + c]);
+    };
+    try ze.check(d.g.api.zeCommandListAppendMemoryCopy(d.list, out, o.ptr, o.len * 2, null, 0, null));
+    try d.sync();
+}
+
+/// The prompt's final normed hidden rows (fp16 [T, D]) through XPU_DUMP_H's path, into memory.
+fn hidden(r: *q.Runner, ids: []const u32) ![]f16 {
+    const fd = memfd_create("xpu_fidelity", 0);
+    if (fd < 0) return error.MemfdFailed;
+    defer _ = close(fd);
+    try r.reset();
+    q.dump_h = fd;
+    defer q.dump_h = null;
+    try r.prompt(ids, true);
+    const h = try alloc.alloc(f16, ids.len * q.D);
+    const bytes = std.mem.sliceAsBytes(h);
+    if (pread(fd, bytes.ptr, bytes.len, 0) != bytes.len) return error.ShortRead;
+    return h;
+}
+
+const Top = struct { t1: u32 = 0, v1: f64 = -std.math.inf(f64), t2: u32 = 0, v2: f64 = -std.math.inf(f64) };
+
+fn push(t: *Top, i: u32, v: f64) void {
+    if (v > t.v1) {
+        t.t2 = t.t1;
+        t.v2 = t.v1;
+        t.t1 = i;
+        t.v1 = v;
+    } else if (v > t.v2) {
+        t.t2 = i;
+        t.v2 = v;
+    }
+}
+
+/// The two top tokens of each row's logits by the FP64 head (same int4 head weights).
+fn headTops(h: []const f16, T: usize) ![]Top {
+    const head = runner.model.head;
+    const ps = try fp64.parts(&runner.ckpt, head, q.LAYERS, 4);
+    const tops = try alloc.alloc(Top, T);
+    @memset(tops, .{});
+    const step: usize = 64; // rows at a time: the FP64 logits of a block fit in memory
+    var r0: usize = 0;
+    while (r0 < T) : (r0 += step) {
+        const R: usize = @min(step, T - r0);
+        const ref = try alloc.alloc(f64, R * head.n);
+        defer alloc.free(ref);
+        try fp64.hostGemm(ps, h[r0 * q.D ..][0 .. R * q.D], R, head.n, ref, &.{});
+        try addReferenceBias(q.LAYERS, 4, ref, R, head.n);
+        for (0..R) |s| for (0..q.VOCAB) |c| push(&tops[r0 + s], @intCast(c), ref[s * head.n + c]);
+    }
+    return tops;
+}
+
+/// The reference's top tokens (int4 GEMMs as fp16(FP64), the rest the device's), kept in XPU_FIDELITY_CACHE when set.
+fn referenceTops(r: *q.Runner, ids: []const u32) ![]Top {
+    const T = ids.len;
+    const path = if (std.c.getenv("XPU_FIDELITY_CACHE")) |v| v else null;
+    if (path) |p| {
+        const fd = open(p, 0);
+        if (fd >= 0) {
+            defer _ = close(fd);
+            const tops = try alloc.alloc(Top, T);
+            const bytes = std.mem.sliceAsBytes(tops);
+            if (pread(fd, bytes.ptr, bytes.len, 0) == bytes.len) return tops;
+        }
+    }
+    fwd.gemm_hook = replace;
+    const h = hidden(r, ids);
+    fwd.gemm_hook = null;
+    const tops = try headTops(try h, T);
+    if (path) |p| {
+        const fd = open(p, 0o1101, @as(c_uint, 0o644)); // write, create, truncate
+        if (fd >= 0) {
+            _ = write(fd, std.mem.sliceAsBytes(tops).ptr, std.mem.sliceAsBytes(tops).len);
+            _ = close(fd);
+        }
+    }
+    return tops;
+}
+
+/// Top tokens of the prompt path (head in FP64) and the decode path against the FP64-GEMM forward, every position.
+pub fn fidelity(r: *q.Runner, ids: []const u32) !void {
+    runner = r;
+    const T = ids.len;
+    if (T > q.CHUNK) return error.PromptLongerThanAChunk;
+    const t0 = q.now();
+    const ours = try headTops(try hidden(r, ids), T);
+    const ref = try referenceTops(r, ids);
+    const t1 = q.now();
+    const dec = try alloc.alloc(Top, T);
+    const logits = try alloc.alloc(f16, q.VOCAB);
+    defer alloc.free(logits);
+    try r.reset();
+    for (0..T) |i| {
+        if (i == 0) try r.prompt(ids[0..1], true) else try r.step(ids[i]);
+        const api = r.d.g.api;
+        const src = r.acts.logits;
+        try ze.check(api.zeCommandListAppendMemoryCopy(r.d.list, logits.ptr, src, q.VOCAB * 2, null, 0, null));
+        try r.d.sync();
+        dec[i] = .{};
+        for (logits, 0..) |v, c| push(&dec[i], @intCast(c), v);
+        if (dec[i].t1 != r.last) return error.DecodeArgmaxMismatch;
+    }
+    std.debug.print("fidelity: {d} positions, reference forward (FP64 GEMMs) {d:.0} s, decode {d:.0} s\n", .{ T, t1 - t0, q.now() - t1 });
+    var min_margin: f64 = std.math.inf(f64);
+    for (ref) |t| min_margin = @min(min_margin, t.v1 - t.v2);
+    std.debug.print("fidelity: smallest FP64 margin {e:.2}\n", .{min_margin});
+    for ([_][]const Top{ ours, dec }, [_][]const u8{ "prompt", "decode" }) |path, name| {
+        var diff: usize = 0;
+        for (path, ref, 0..) |a, f, i| if (a.t1 != f.t1) {
+            diff += 1;
+            std.debug.print("| {s} | {d} | {d} ", .{ name, i, ids[@min(i + 1, T - 1)] });
+            std.debug.print("| {d} ({d:.4}) | {d} ({d:.4}) | {e:.2} ", .{ f.t1, f.v1, f.t2, f.v2, f.v1 - f.v2 });
+            std.debug.print("| {d} ({d:.4}) | {d} ({d:.4}) | {e:.2} |\n", .{ a.t1, a.v1, a.t2, a.v2, a.v1 - a.v2 });
+        };
+        std.debug.print("fidelity: {s} path, top-1 differences against FP64: {d} of {d}\n", .{ name, diff, T });
+    }
+    var pd: usize = 0;
+    for (ours, dec) |a, b| pd += @intFromBool(a.t1 != b.t1);
+    std.debug.print("fidelity: prompt and decode paths differ at {d} of {d} positions\n", .{ pd, T });
+}
