+# INK2_HYBRID_PREFIX_SDPA=1 routes the bias-free KV prefix ([0, K0//page)
+# where K0 = seqlen - nt - rel_extent + 1) of full-attention prefill layers
+# through oneDNN flash SDPA in <=_SDPA_WIN-page windows, merged with the
+# Triton relative-bias tail via fp32 online softmax (LSE). Default 0 keeps
+# the stock Chunked-LSE Triton path for all pages.
+_HYBRID_PREFIX_SDPA = os.environ.get("INK2_HYBRID_PREFIX_SDPA", "0") == "1"
+_SDPA_WIN = 128  # pages per SDPA window (8192 tokens)
+
+
+def _merge_lse(
+    out: torch.Tensor,
+    lse: torch.Tensor,
+    o_other: torch.Tensor,
+    l_other: torch.Tensor,
+    nt: int,
+) -> None:
+    """Merge `(o_other, l_other)` into `(out, lse)` in place (fp32 LSE)."""
+    l0 = lse[:, :nt]
+    l1 = l_other[:, :nt] if l_other.dim() == 2 else l_other
+    m = torch.maximum(l0, l1)
+    m_safe = torch.where(torch.isinf(m), torch.zeros_like(m), m)
+    w0 = torch.exp(l0 - m_safe)
+    w1 = torch.exp(l1 - m_safe)
+    ws = w0 + w1
+    ws_safe = torch.where(ws == 0, torch.ones_like(ws), ws)
+    lse[:, :nt] = torch.where(
+        ws == 0, torch.full_like(m, float("-inf")), m_safe + torch.log(ws_safe)
+    )
+    out[:nt] = out[:nt] * (w0 / ws_safe).t().unsqueeze(
+        -1
+    ) + o_other[:nt] * (w1 / ws_safe).t().unsqueeze(-1)
 
 
