 tests/test-backend-ops.cpp       |   5 ++
 2 files changed, 143 insertions(+)

diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index f1882d643..81992e54b 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -2530,12 +2530,140 @@ static void scale_f32(const float * x, float * dst, const float scale, const flo
 }
 
 
+// local patch (newmodels): GQA-grouped decode attention mat-vecs. The kernels above run one work-group per
+// (query head, row), so each KV row is read once per query head that shares it (3x for Inkling 2 Mini: 24 query
+// heads, 8 KV heads). These run one work-group per (KV head, row) and keep R per-head partial sums. Each lane
+// visits the same columns in the same order and the xor reduction tree is unchanged, so every output keeps the
+// arithmetic of the original kernel; only the loads of x are shared.
+template <int R>
+static void mul_mat_p021_f16_f32_gqa(const void * __restrict__ vx, const float * __restrict__ y, float * __restrict__ dst,
+                                     const int ncols_x, const int nrows_x, const int nchannels_x,
+                                     const sycl::nd_item<3> & item_ct1) {
+    const sycl::half * x = (const sycl::half *) vx;
+    const int row_x     = item_ct1.get_group(1);
+    const int channel_x = item_ct1.get_group(0);
+    const int nrows_y   = ncols_x;
+    float tmp[R];
+#pragma unroll
+    for (int h = 0; h < R; ++h) {
+        tmp[h] = 0.0f;
+    }
+    for (int col_x0 = 0; col_x0 < ncols_x; col_x0 += item_ct1.get_local_range(2)) {
+        const int col_x = col_x0 + item_ct1.get_local_id(2);
+        if (col_x >= ncols_x) {
+            break;
+        }
+        const int   ix = row_x*nchannels_x*ncols_x + channel_x*ncols_x + col_x;
+        const float xi = sycl::vec<sycl::half, 1>(x[ix]).convert<float, sycl::rounding_mode::automatic>()[0];
+#pragma unroll
+        for (int h = 0; h < R; ++h) {
+            const int channel = channel_x*R + h;
+            tmp[h] += xi * y[channel*nrows_y + col_x];
+        }
+    }
+#pragma unroll
+    for (int h = 0; h < R; ++h) {
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            tmp[h] += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp[h], mask);
+        }
+    }
+    if (item_ct1.get_local_id(2) == 0) {
+#pragma unroll
+        for (int h = 0; h < R; ++h) {
+            dst[(channel_x*R + h)*nrows_x + row_x] = tmp[h];
+        }
+    }
+}
+
+template <int R>
+static void mul_mat_vec_nc_f16_f32_gqa(const void * __restrict__ vx, const float * __restrict__ y, float * __restrict__ dst,
+                                       const int ncols_x, const int nrows_x, const int row_stride_x,
+                                       const int channel_stride_x, const int channel_stride_y,
+                                       const sycl::nd_item<3> & item_ct1) {
+    const sycl::half * x = (const sycl::half *) vx;
+    const int row_x     = item_ct1.get_group(1);
+    const int channel_x = item_ct1.get_group(0);
+    float tmp[R];
+#pragma unroll
+    for (int h = 0; h < R; ++h) {
+        tmp[h] = 0.0f;
+    }
+    for (int col_x0 = 0; col_x0 < ncols_x; col_x0 += item_ct1.get_local_range(2)) {
+        const int col_x = col_x0 + item_ct1.get_local_id(2);
+        if (col_x >= ncols_x) {
+            break;
+        }
+        const int   ix = channel_x*channel_stride_x + row_x*row_stride_x + col_x;
+        const float xi = sycl::vec<sycl::half, 1>(x[ix]).convert<float, sycl::rounding_mode::automatic>()[0];
+#pragma unroll
+        for (int h = 0; h < R; ++h) {
+            const int channel = channel_x*R + h;
+            tmp[h] += xi * y[channel*channel_stride_y + col_x];
+        }
+    }
+#pragma unroll
+    for (int h = 0; h < R; ++h) {
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            tmp[h] += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp[h], mask);
+        }
+    }
+    if (item_ct1.get_local_id(2) == 0) {
+#pragma unroll
+        for (int h = 0; h < R; ++h) {
+            dst[(channel_x*R + h)*nrows_x + row_x] = tmp[h];
+        }
+    }
+}
+
+template <int R>
+static void launch_p021_gqa(const void * vx, const float * y, float * dst, int ncols_x, int nrows_x, int nchannels_x,
+                            queue_ptr stream) {
+    const sycl::range<3> block_nums(nchannels_x, nrows_x, 1);
+    const sycl::range<3> block_dims(1, 1, WARP_SIZE);
+    stream->parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                         [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             mul_mat_p021_f16_f32_gqa<R>(vx, y, dst, ncols_x, nrows_x, nchannels_x, item_ct1);
+                         });
+}
+
+template <int R>
+static void launch_nc_gqa(const void * vx, const float * y, float * dst, int ncols_x, int nrows_x, int row_stride_x,
+                          int nchannels_x, int channel_stride_x, int channel_stride_y, queue_ptr stream) {
+    const sycl::range<3> block_nums(nchannels_x, nrows_x, 1);
+    const sycl::range<3> block_dims(1, 1, WARP_SIZE);
+    stream->parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                         [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             mul_mat_vec_nc_f16_f32_gqa<R>(vx, y, dst, ncols_x, nrows_x, row_stride_x, channel_stride_x,
+                                                           channel_stride_y, item_ct1);
+                         });
+}
+
+static bool ggml_sycl_gqa_ratio(int nchannels_x, int nchannels_y, int & r) {
+    static const bool disabled = getenv("GGML_SYCL_NO_GQA_MV") != nullptr;  // same-binary A/B switch
+    if (disabled || nchannels_x <= 0 || nchannels_y % nchannels_x != 0) {
+        return false;
+    }
+    r = nchannels_y / nchannels_x;
+    return r == 2 || r == 3 || r == 4 || r == 8;
+}
+
 static void ggml_mul_mat_p021_f16_f32_sycl(const void *vx, const float *y,
                                            float *dst, const int ncols_x,
                                            const int nrows_x,
                                            const int nchannels_x,
                                            const int nchannels_y,
                                            queue_ptr stream) {
+    if (int r = 0; ggml_sycl_gqa_ratio(nchannels_x, nchannels_y, r)) {
+        dpct::has_capability_or_fail(stream->get_device(), {sycl::aspect::fp16});
+        switch (r) {
+            case 2: launch_p021_gqa<2>(vx, y, dst, ncols_x, nrows_x, nchannels_x, stream); return;
+            case 3: launch_p021_gqa<3>(vx, y, dst, ncols_x, nrows_x, nchannels_x, stream); return;
+            case 4: launch_p021_gqa<4>(vx, y, dst, ncols_x, nrows_x, nchannels_x, stream); return;
+            case 8: launch_p021_gqa<8>(vx, y, dst, ncols_x, nrows_x, nchannels_x, stream); return;
+        }
+    }
 
     const sycl::range<3> block_nums(nchannels_y, nrows_x, 1);
     const sycl::range<3> block_dims(1, 1, WARP_SIZE);
@@ -2557,6 +2685,16 @@ static void ggml_mul_mat_vec_nc_f16_f32_sycl(
     const int nrows_x, const int row_stride_x, const int nchannels_x,
     const int nchannels_y, const int channel_stride_x, const int channel_stride_y, queue_ptr stream) {
 
+    if (int r = 0; ggml_sycl_gqa_ratio(nchannels_x, nchannels_y, r)) {
+        dpct::has_capability_or_fail(stream->get_device(), {sycl::aspect::fp16});
+        switch (r) {
+            case 2: launch_nc_gqa<2>(vx, y, dst, ncols_x, nrows_x, row_stride_x, nchannels_x, channel_stride_x, channel_stride_y, stream); return;
+            case 3: launch_nc_gqa<3>(vx, y, dst, ncols_x, nrows_x, row_stride_x, nchannels_x, channel_stride_x, channel_stride_y, stream); return;
+            case 4: launch_nc_gqa<4>(vx, y, dst, ncols_x, nrows_x, row_stride_x, nchannels_x, channel_stride_x, channel_stride_y, stream); return;
+            case 8: launch_nc_gqa<8>(vx, y, dst, ncols_x, nrows_x, row_stride_x, nchannels_x, channel_stride_x, channel_stride_y, stream); return;
+        }
+    }
+
     const sycl::range<3> block_nums(nchannels_y, nrows_x, 1);
     const sycl::range<3> block_dims(1, 1, WARP_SIZE);
     {
