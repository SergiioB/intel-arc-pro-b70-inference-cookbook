+// multi-token MoE expert GEMV: like mul_mat_vec_q_moe, but for M > 1 routed tokens.
+// Slot s in [0, n_ids_per_tok * n_tokens) decomposes as token t = s / n_ids_per_tok and
+// expert slot j = s % n_ids_per_tok; the expert id is ids[j][t] (ids row stride in elements),
+// the activation column is token t's, and dst stays slot-linear (ggml mul_mat_id layout).
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void mul_mat_vec_q_moe_mt(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev,
+    const int ncols, const int nrows,
+    const int n_ids_per_tok, const int n_tokens, const size_t ids_row_stride,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_stride, const bool src1_slot_linear,
+    const sycl::nd_item<3> & item_ct1) {
+
+    const int slot_lin = item_ct1.get_group(1);
+    const int token    = slot_lin / n_ids_per_tok;
+    const int slot     = slot_lin % n_ids_per_tok;
+
+    // ggml ids layout [k, T] row-major: element (slot j, token t) at t*k + j
+    const int i02 = ids_dev[(size_t) token * ids_row_stride + slot];
+
+    const char * vx = (const char *) vx_base + (size_t) i02 * expert_weight_stride;
+    // gate_up form: one src1 row per token (index by token)
+    // grouped/down form: one src1 row per (token, expert-slot) (index by slot)
+    const char * vy = (const char *) vy_base
+        + (size_t)(src1_slot_linear ? slot_lin : token) * src1_stride;
+    float *      dst = (float *) ((char *) dst_base + (size_t) slot_lin * dst_row_stride);
+
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) + item_ct1.get_local_id(1);
+
+    if (row >= nrows) {
+        return;
+    }
+
+    const int     blocks_per_row  = ncols / qk;
+    constexpr int blocks_per_warp = (vdr * WARP_SIZE + qi - 1) / qi;
+
+    float tmp = 0.0f;
+
+    const block_q_t *  x = (const block_q_t *) vx;
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+
+    for (int i = item_ct1.get_local_id(2) / (qi / vdr); i < blocks_per_row; i += blocks_per_warp) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i * (qk / QK8_1);
+
+        for (size_t elem = 0; elem < qi / vdr; elem += WARP_SIZE) {
+            const int iqs = elem + vdr * (item_ct1.get_local_id(2) % (qi / vdr));
+            tmp += vec_dot_q_sycl(&x[ibx], &y[iby], iqs);
+        }
+    }
+
+#pragma unroll
+    for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        tmp += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp, mask);
+    }
+
+    if (item_ct1.get_local_id(2) == 0) {
+        dst[row] = tmp;
+    }
+}
+
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_moe_mt(
+    const void * vx_base, const void * vy, const int32_t * ids_dev,
+    float * dst_base, const int ncols, const int nrows,
+    const int n_ids_per_tok, const int n_tokens, const size_t ids_row_stride,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t src1_stride, const bool src1_slot_linear,
+    dpct::queue_ptr stream) {
+    const int            n_slots    = n_ids_per_tok * n_tokens;
+    const int            block_num_y = (nrows + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums(1, (unsigned) n_slots, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_moe_mt<qk, qi, block_q_t, vdr, vec_dot_q_sycl>(
+                    vx_base, vy, dst_base, ids_dev, ncols, nrows,
+                    n_ids_per_tok, n_tokens, ids_row_stride,
+                    expert_weight_stride, dst_row_stride, src1_stride, src1_slot_linear, item);
+            });
+    });
+}
