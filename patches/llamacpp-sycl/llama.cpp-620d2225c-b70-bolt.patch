+// dst = relu(x)^2 for a UNARY(RELU) + SQR chain (squared ReLU of Nemotron-H FFN/MoE), one pass
+// over the activations instead of two. Preconditions come from ggml_sycl_can_fuse(); re-asserted here.
+void ggml_sycl_op_relu_sqr_fused(ggml_backend_sycl_context & ctx, ggml_tensor * relu_node, ggml_tensor * sqr_node) {
+    scope_op_debug_print scope_dbg_print(__func__, sqr_node, /*num_src=*/1);
+
+    const ggml_tensor * x = relu_node->src[0];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && relu_node->type == GGML_TYPE_F32 && sqr_node->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(sqr_node) && ggml_are_same_shape(x, sqr_node));
+
+    queue_ptr main_stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const int64_t k          = ggml_nelements(sqr_node);
+    const float * src        = (const float *) x->data;
+    float *       dst        = (float *) sqr_node->data;
+    const size_t  num_blocks = ceil_div((size_t) k, (size_t) SYCL_SQR_BLOCK_SIZE);
+    main_stream->parallel_for(
+        sycl::nd_range<1>(num_blocks * sycl::range<1>(SYCL_SQR_BLOCK_SIZE), sycl::range<1>(SYCL_SQR_BLOCK_SIZE)),
+        [=](sycl::nd_item<1> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            SYCL_GLOBAL_ID_LOOP(k, item_ct1) {
+                dst[i] = op_sqr(op_relu(src[i]));
+            }
+        });
+}
