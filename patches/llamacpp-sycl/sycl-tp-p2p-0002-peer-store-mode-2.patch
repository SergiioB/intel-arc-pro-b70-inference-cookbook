+// Each rank stores its partial into the peer's inbox. A one-item kernel then raises the peer's flag, so the
+// kernel boundary orders all stores before the flag. A third kernel waits on the local flag and adds the inbox.
+// No events cross queues and the host never waits.
+static void ggml_sycl_comm_allreduce_flag(ggml_backend_sycl_comm_context * comm, queue_ptr q0, queue_ptr q1,
+                                          float * out0, float * out1, int64_t nelem) {
+    queue_ptr q[2]   = { q0, q1 };
+    float *   out[2] = { out0, out1 };
+    if (comm->inbox_nelem < nelem) {
+        q0->wait();
+        q1->wait();
+        for (int d = 0; d < 2; ++d) {
+            if (comm->inbox[d]) {
+                sycl::free(comm->inbox[d], *q[d]);
+            }
+            comm->inbox[d] = sycl::malloc_device<float>(2 * nelem, *q[d]);
+            GGML_ASSERT(comm->inbox[d]);
+        }
+        comm->inbox_nelem = nelem;
+    }
+    const uint32_t seq  = ++comm->seq;
+    const int64_t  slot = (seq & 1) * comm->inbox_nelem;
+    constexpr int  WG   = 256;
+    constexpr uint32_t max_spins = 1u << 23; // about 1-2 s, below the xe job timeout
+    const int64_t n_groups = std::min<int64_t>((nelem + WG - 1) / WG, 256);
+
+    for (int d = 0; d < 2; ++d) {
+        const float * src       = out[d];
+        float *       dst       = comm->inbox[1 - d] + slot;
+        uint32_t *    peer_flag = comm->flags[1 - d];
+        q[d]->parallel_for(sycl::nd_range<1>(n_groups * WG, WG), [=](sycl::nd_item<1> it) {
+            for (int64_t i = it.get_global_linear_id(); i < nelem; i += n_groups * WG) {
+                dst[i] = src[i];
+            }
+            sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::system);
+        });
+        q[d]->single_task([=]() {
+            sycl::atomic_fence(sycl::memory_order::seq_cst, sycl::memory_scope::system);
+            *reinterpret_cast<volatile uint32_t *>(peer_flag) = seq;
+            sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::system);
+        });
+    }
+    for (int d = 0; d < 2; ++d) {
+        float *        dst      = out[d];
+        const float *  in       = comm->inbox[d] + slot;
+        uint32_t *     my_flag  = comm->flags[d];
+        uint32_t *     timeouts = comm->flags[d] + 32;
+        q[d]->parallel_for(sycl::nd_range<1>(n_groups * WG, WG), [=](sycl::nd_item<1> it) {
+            if (it.get_local_linear_id() == 0) {
+                sycl::atomic_ref<uint32_t, sycl::memory_order::relaxed, sycl::memory_scope::system,
+                                 sycl::access::address_space::global_space> flag(*my_flag);
+                uint32_t spins = 0;
+                while ((int32_t) (flag.load() - seq) < 0 && ++spins < max_spins) {
+                }
+                if (spins >= max_spins) {
+                    sycl::atomic_ref<uint32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                                     sycl::access::address_space::global_space>(*timeouts).fetch_add(1u);
+                }
+                sycl::atomic_fence(sycl::memory_order::acquire, sycl::memory_scope::system);
+            }
+            sycl::group_barrier(it.get_group());
+            sycl::atomic_fence(sycl::memory_order::acquire, sycl::memory_scope::system);
+            for (int64_t i = it.get_global_linear_id(); i < nelem; i += n_groups * WG) {
+                dst[i] += in[i];
+            }
+        });
+    }
+}
