+// returns per-token final-layer hidden states: {"shape": [L, H], "hidden_fp16_le": "<base64 LE fp16, row-major LxH>"}
+// errors are reported as non-200 with {"error": "..."}
+std::unique_ptr<server_res_generator> server_routes::handle_hidden_states(const server_http_req & req) {
+    constexpr int32_t n_tokens_max = 65536;
+
+    auto res = create_response();
+
+    const auto fail = [&res](int status, const std::string & msg) {
+        res->status = status;
+        res->data   = safe_json_to_str(json{{"error", msg}});
+    };
+
+    if (!params.embedding) {
+        fail(400, "hidden states require the server to be started with `--embeddings`");
+        return res;
+    }
+
+    if (meta->pooling_type != LLAMA_POOLING_TYPE_NONE) {
+        fail(400, "hidden states require pooling type 'none', current model uses a different pooling type");
+        return res;
+    }
+
+    json body;
+    try {
+        body = json::parse(req.body);
+    } catch (const std::exception &) {
+        fail(400, "invalid JSON body");
+        return res;
+    }
+
+    if (!body.contains("prompt") || !body.at("prompt").is_string()) {
+        fail(400, "\"prompt\" must be provided as a string");
+        return res;
+    }
+    const std::string prompt = body.at("prompt").get<std::string>();
+
+    int32_t max_tokens = n_tokens_max;
+    if (body.contains("max_tokens")) {
+        if (!body.at("max_tokens").is_number_integer()) {
+            fail(400, "\"max_tokens\" must be an integer");
+            return res;
+        }
+        max_tokens = body.at("max_tokens").get<int32_t>();
+        if (max_tokens < 1 || max_tokens > n_tokens_max) {
+            fail(400, "\"max_tokens\" must be between 1 and 65536");
+            return res;
+        }
+    }
+
+    // tokenize verbatim: no chat template, no special tokens
+    llama_tokens tokens = common_tokenize(ctx_server.vocab, prompt, false, false);
+    if (tokens.empty()) {
+        fail(400, "prompt produced zero tokens");
+        return res;
+    }
+    if ((int32_t) tokens.size() > max_tokens) {
+        fail(400, string_format("prompt has %d tokens, exceeds max_tokens = %d", (int) tokens.size(), max_tokens));
+        return res;
+    }
+
+    // create and queue the task
+    auto & rd = res->rd;
+    {
+        std::vector<server_task> tasks;
+
+        server_task task = server_task(SERVER_TASK_TYPE_EMBEDDING);
+
+        task.id     = rd.get_new_id();
+        task.tokens = server_tokens(tokens, false);
+
+        task.params.res_type       = TASK_RESPONSE_TYPE_NONE;
+        task.params.embd_normalize = -1; // no normalization (also skipped by pooling type 'none')
+
+        tasks.push_back(std::move(task));
+        rd.post_tasks(std::move(tasks));
+    }
+
+    // wait for the result
+    auto all_results = rd.wait_for_all(req.should_stop);
+    if (all_results.is_terminated) {
+        return res; // connection is closed
+    }
+    if (all_results.error) {
+        const json err = all_results.error->to_json();
+        fail(json_value(err, "code", 500), json_value(err, "message", std::string("task failed")));
+        return res;
+    }
+
+    GGML_ASSERT(all_results.results.size() == 1);
+    auto * result = dynamic_cast<server_task_result_embd *>(all_results.results[0].get());
+    GGML_ASSERT(result != nullptr);
+
+    const int32_t n_tokens = (int32_t) result->embedding.size();
+    const int32_t n_embd   = n_tokens > 0 ? (int32_t) result->embedding[0].size() : 0;
+    if (n_tokens <= 0 || n_embd <= 0) {
+        fail(500, "no hidden states were returned");
+        return res;
+    }
+    for (const auto & row : result->embedding) {
+        if ((int32_t) row.size() != n_embd) {
+            fail(500, "inconsistent hidden state size across tokens");
+            return res;
+        }
+    }
+
+    // f32 -> fp16, little-endian byte order
+    std::vector<uint8_t> buf;
+    buf.reserve((size_t) n_tokens * n_embd * sizeof(ggml_fp16_t));
+    std::vector<ggml_fp16_t> row_fp16(n_embd);
+    for (const auto & row : result->embedding) {
+        ggml_fp32_to_fp16_row(row.data(), row_fp16.data(), n_embd);
+        for (int32_t i = 0; i < n_embd; ++i) {
+            buf.push_back((uint8_t) (row_fp16[i] & 0xff));
+            buf.push_back((uint8_t) (row_fp16[i] >> 8));
+        }
+    }
+
+    res->ok(json{
+        {"shape",          json::array({n_tokens, n_embd})},
+        {"hidden_fp16_le", base64::encode((const char *) buf.data(), buf.size())},
+    });
+    return res;
+}
