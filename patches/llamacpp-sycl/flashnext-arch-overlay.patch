+// LLM_GRAPH_TYPE_DECODER_MTP draft head for Qwen3.8-Flash-Next
+llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_graph_params & params)
+    : graph_base(model, params) {
+    GGML_ASSERT(hparams.n_layer_nextn > 0 && "QWEN4EXP MTP requires n_layer_nextn > 0");
+    GGML_ASSERT(hparams.n_layer_nextn == 1 && "QWEN4EXP MTP currently only supports a single MTP block");
+
+    const int64_t hc = hparams.dsv4_hc_mult;
+
+    const int il = hparams.n_layer();
+    const auto & layer = model.layers[il];
+
+    GGML_ASSERT(layer.nextn.enorm        && "MTP block missing nextn.enorm");
+    GGML_ASSERT(layer.nextn.hnorm        && "MTP block missing nextn.hnorm");
+    GGML_ASSERT(layer.nextn.fc_embedding && "MTP block missing nextn.fc_embedding");
+    GGML_ASSERT(layer.nextn.fc_hidden    && "MTP block missing nextn.fc_hidden");
+    GGML_ASSERT(layer.ffn_gate_inp       && "MTP block missing ffn_gate_inp");
+
+    int sections[4];
+    std::copy(std::begin(hparams.rope_sections), std::begin(hparams.rope_sections) + 4, sections);
+
+    auto inp = std::make_unique<llm_graph_input_embd_h>(hparams.n_embd_nextn());
+
+    inp->tokens = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens);
+    ggml_set_input(inp->tokens);
+
+    inp->embd = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hparams.n_embd_inp(), n_tokens);
+    ggml_set_input(inp->embd);
+
+    // TODO: make static using `ggml_build_forward_select()`
+    //       see llm_graph_context::build_inp_embd() for reference
+    ggml_tensor * tok_embd;
+    if (ubatch.token) {
+        tok_embd = ggml_get_rows(ctx0, model.tok_embd, inp->tokens);
+    } else {
+        tok_embd = inp->embd;
+    }
+    cb(tok_embd, "mtp_tok_embd", il);
+
+    inp->h = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hparams.n_embd_nextn(), n_tokens);
+    ggml_set_input(inp->h);
+    ggml_set_name(inp->h, "mtp_h_input");
+
+    ggml_tensor * h_embd = inp->h;
+
+    res->add_input(std::move(inp));
+
+    ggml_tensor * inp_pos     = build_inp_pos();
+    ggml_tensor * inp_out_ids = build_inp_out_ids();
+
+    auto * inp_attn = build_attn_inp_kv();
+
+    // input fusion (the reference _fuse_residual_linear_shared): the draft
+    // residual is hc-wide - the projected embedding broadcasts over the streams
+    ggml_tensor * e = build_norm(tok_embd, layer.nextn.enorm, nullptr, LLM_NORM_RMS, il);
+    e = build_lora_mm(layer.nextn.fc_embedding, e);
+    cb(e, "mtp_fc_embedding", il);
+
+    ggml_tensor * h = build_norm(h_embd, layer.nextn.hnorm, nullptr, LLM_NORM_RMS, il);
+    h = ggml_reshape_3d(ctx0, h, n_embd, hc, n_tokens);
+    h = build_lora_mm(layer.nextn.fc_hidden, h);
+    cb(h, "mtp_fc_hidden", il);
+
+    ggml_tensor * res_hc = ggml_add(ctx0, h,
+            ggml_repeat_4d(ctx0, ggml_reshape_3d(ctx0, e, n_embd, 1, n_tokens), n_embd, hc, n_tokens, 1));
+    cb(res_hc, "mtp_fused", il);
+
+    ggml_tensor * inject = nullptr;
+    ggml_tensor * cur = build_hc_mix(res_hc,
+            layer.hc_attn_norm, layer.hc_attn_down, layer.hc_attn_up, layer.hc_attn_inject,
+            &inject, il);
+
+    cur = build_attn_dense(inp_attn, cur, inp_pos, sections, il);
+
+    res_hc = build_hc_combine(res_hc, cur, inject, il);
+
+    cur = build_hc_mix(res_hc,
+            layer.hc_ffn_norm, layer.hc_ffn_down, layer.hc_ffn_up, layer.hc_ffn_inject,
+            &inject, il);
+
+    cur = build_layer_ffn(cur, il);
+    cb(cur, "mtp_ffn_out", il);
+
+    res_hc = build_hc_combine(res_hc, cur, inject, il);
+
+    // the hc-wide output feeds the next draft step
+    ggml_tensor * h_nextn = ggml_reshape_2d(ctx0, res_hc, n_embd*hc, n_tokens);
+    cb(h_nextn, "h_nextn", -1);
+    res->t_h_nextn = h_nextn;
+    ggml_build_forward_expand(gf, h_nextn);
+
+    // the draft file maps the MTP output mixer to the hc_head names
+    cur = build_hc_mix(res_hc,
+            model.hc_head_norm, model.hc_head_down, model.hc_head_up,
+            nullptr, nullptr, -1);
+
+    cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+    cb(cur, "result_norm", -1);
+    res->t_embd = cur;
+
+    // the draft shares the trunk LM head
+    cur = build_lora_mm(model.output, cur, model.output_s);
+    cb(cur, "result_output", -1);
+    res->t_logits = cur;
+
+    ggml_build_forward_expand(gf, cur);
+}
