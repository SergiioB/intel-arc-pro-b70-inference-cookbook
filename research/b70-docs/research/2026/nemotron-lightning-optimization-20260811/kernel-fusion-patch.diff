 using namespace sycl;
 
+// Split-input fused conv kernel: reads directly from conv_state + xBC
+// (eliminates concat + transpose + state-cpy dispatches).
+// Also fuses bias + SiLU and in-place state update for n_t == 1.
+static void kernel_ssm_conv_split(
+    queue &q,
+    const float *conv_state_data,  // [d_conv-1, d_inner, n_s]
+    const float *xbc_data,          // [d_inner, n_t, n_s]
+    const float *weights,           // [d_conv, d_inner]
+    float *dst_data,
+    const float *bias_data,         // optional [d_inner]
+    float *conv_state_out,          // same as conv_state_data for in-place update (n_t==1 only)
+    int d_conv,
+    int d_inner,
+    int n_t,
+    int n_s,
+    int conv_state_stride_inner,    // d_conv - 1
+    int conv_state_stride_seq,      // (d_conv-1) * d_inner
+    int xbc_stride_token,           // d_inner
+    int xbc_stride_seq,             // d_inner * n_t
+    int dst_stride_token,           // d_inner
+    int dst_stride_seq              // d_inner * n_t
+) {
+    const size_t total_work = static_cast<size_t>(d_inner) * static_cast<size_t>(n_t) * static_cast<size_t>(n_s);
+    const size_t work_group_size = 256;
+    const size_t num_work_groups = (total_work + work_group_size - 1) / work_group_size;
+
+    const range<1> global_range(num_work_groups * work_group_size);
+    const range<1> local_range(work_group_size);
+
+    q.submit([&](handler &h) {
+        h.parallel_for(
+            nd_range<1>(global_range, local_range),
+            [=](nd_item<1> item) {
+                const size_t idx = item.get_global_id(0);
+                if (idx >= total_work) return;
+
+                const int token   = static_cast<int>(idx % n_t);
+                const int channel = static_cast<int>((idx / n_t) % d_inner);
+                const int seq     = static_cast<int>(idx / (static_cast<size_t>(n_t) * static_cast<size_t>(d_inner)));
+
+                const float *c = weights + static_cast<size_t>(channel) * static_cast<size_t>(d_conv);
+
+                const float *cs_base = conv_state_data
+                    + static_cast<size_t>(seq) * static_cast<size_t>(conv_state_stride_seq)
+                    + static_cast<size_t>(channel) * static_cast<size_t>(conv_state_stride_inner);
+
+                const float *xbc_base = xbc_data
+                    + static_cast<size_t>(seq) * static_cast<size_t>(xbc_stride_seq);
+
+                // Compute conv by reading from conv_state (history) + xBC (current tokens)
+                float sumf = 0.0f;
+                for (int j = 0; j < d_conv; ++j) {
+                    const int virt_pos = token + j;  // position in virtual concatenated array
+                    float val;
+                    if (virt_pos < d_conv - 1) {
+                        // Read from conv_state history
+                        val = cs_base[virt_pos];
+                    } else {
+                        // Read from xBC
+                        const int xbc_tok = virt_pos - (d_conv - 1);
+                        val = xbc_base[xbc_tok * xbc_stride_token + channel];
+                    }
+                    sumf += val * c[j];
+                }
+
+                // Fused bias + SiLU
+                if (bias_data != nullptr) {
+                    sumf += bias_data[channel];
+                    sumf = sumf / (1.0f + sycl::exp(-sumf));
+                }
+
+                const size_t dst_idx =
+                    static_cast<size_t>(seq) * static_cast<size_t>(dst_stride_seq) +
+                    static_cast<size_t>(token) * static_cast<size_t>(dst_stride_token) +
+                    static_cast<size_t>(channel);
+                dst_data[dst_idx] = sumf;
+
+                // In-place state update for single-token decode (no race: 1 thread per channel)
+                if (n_t == 1 && conv_state_out != nullptr) {
+                    float *cs_out = conv_state_out
+                        + static_cast<size_t>(seq) * static_cast<size_t>(conv_state_stride_seq)
+                        + static_cast<size_t>(channel) * static_cast<size_t>(conv_state_stride_inner);
+                    // Shift ring buffer left by 1
+                    for (int i = 0; i < d_conv - 2; ++i) {
+                        cs_out[i] = cs_out[i + 1];
+                    }
+                    // Write current xBC value at the end
+                    cs_out[d_conv - 2] = xbc_base[channel];
+                }
+            }
+        );
+    });
+}
