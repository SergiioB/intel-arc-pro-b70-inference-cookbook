+static_assert(EXL3_K3_NT_MR2 == 4 || EXL3_K3_NT_MR2 == 8, "K3 MR2 NT must be 4 or 8");
+static_assert(EXL3_K3_NT_MR4 == 4 || EXL3_K3_NT_MR4 == 8, "K3 MR4 NT must be 4 or 8");
