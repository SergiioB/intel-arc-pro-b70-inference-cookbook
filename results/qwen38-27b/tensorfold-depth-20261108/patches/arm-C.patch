+// Tree verify on one stream with the bf16 cache: one work-group per (slice, K/V head), subgroup t holds tree row t.
+// The slice's prefix rows (below p0, the same for every tree row) are staged in local memory once per round instead
+// of once per row; each row then runs attn_decode's loop in the same order, so its partials are bit-identical.
+#define TTILE 32
+__attribute__((intel_reqd_sub_group_size(16))) __attribute__((reqd_work_group_size(256, 1, 1))) kernel void
+attn_decode_tree(global const ushort *Q, global const ushort *KC, global const ushort *VC, global float *PM,
+                 global float *PL, global float *PO, int p0, int NS, float scale, global const int *TREE, int T) {
+  local ushort sk[TTILE * 256], sv[TTILE * 256];
+  const int sp = get_group_id(0), hk = get_group_id(1), t = get_sub_group_id(), lane = get_sub_group_local_id();
+  const int lid = get_local_id(0);
+  const bool on = t < T;
+  const int base = p0, wf = 0;
+  const int last = on ? p0 + DEPTH(t) : p0, j0 = sp * SPLIT, j1 = min(j0 + SPLIT, last + 1);
+  const int pe = min(j0 + SPLIT, base); // end of the shared prefix rows in this slice (uniform in the group)
+  float q[Q27_QPG][16], o[Q27_QPG][16], m[Q27_QPG], l[Q27_QPG];
+  for (int a = 0; a < Q27_QPG; a++) {
+    for (int i = 0; i < 16; i++) {
+      q[a][i] = on ? bf2f(Q[((long)t * Q27_AQ + hk * Q27_GQA + a) * 256 + i * 16 + lane]) : 0.0f;
+      o[a][i] = 0.0f;
+    }
+    m[a] = -INFINITY;
+    l[a] = 0.0f;
+  }
+#define TREE_ROW(KV_K, KV_V)                                                                                           \
+  {                                                                                                                    \
+    float kv[16];                                                                                                      \
+    for (int i = 0; i < 16; i++) kv[i] = bf2f(KV_K(i));                                                                \
+    float sc[Q27_QPG];                                                                                                 \
+    for (int a = 0; a < Q27_QPG; a++) {                                                                                \
+      float d = 0.0f;                                                                                                  \
+      for (int i = 0; i < 16; i++) d += q[a][i] * kv[i];                                                               \
+      sc[a] = sub_group_reduce_add(d) * scale;                                                                         \
+    }                                                                                                                  \
+    for (int i = 0; i < 16; i++) kv[i] = bf2f(KV_V(i));                                                                \
+    for (int a = 0; a < Q27_QPG; a++) {                                                                                \
+      const float mn = fmax(m[a], sc[a]);                                                                              \
+      const float al = exp(m[a] - mn), p = exp(sc[a] - mn);                                                            \
+      l[a] = l[a] * al + p;                                                                                            \
+      for (int i = 0; i < 16; i++) o[a][i] = o[a][i] * al + p * kv[i];                                                 \
+      m[a] = mn;                                                                                                       \
+    }                                                                                                                  \
+  }
+  for (int jt = j0; jt < pe; jt += TTILE) {
+    const int nt = min(TTILE, pe - jt);
+    for (int e = lid; e < nt * 256; e += 256) {
+      const long g = ((long)(jt + (e >> 8)) * Q27_AKV + hk) * 256 + (e & 255);
+      sk[e] = KC[g];
+      sv[e] = VC[g];
+    }
+    barrier(CLK_LOCAL_MEM_FENCE);
+    if (on)
+      for (int r = 0; r < nt; r++) {
+#define SK(i) sk[r * 256 + (i) * 16 + lane]
+#define SV(i) sv[r * 256 + (i) * 16 + lane]
+        TREE_ROW(SK, SV)
+#undef SK
+#undef SV
+      }
+    barrier(CLK_LOCAL_MEM_FENCE);
+  }
+  if (!on) return;
+  for (int j = max(j0, base); j < j1; j++) {
+    const long kr = base + ANC(t, j - base) - wf; // the tree rows, through the ancestor table
+#define GK(i) KC[(kr * Q27_AKV + hk) * 256 + (i) * 16 + lane]
+#define GV(i) VC[(kr * Q27_AKV + hk) * 256 + (i) * 16 + lane]
+    TREE_ROW(GK, GV)
+#undef GK
+#undef GV
+  }
+#undef TREE_ROW
+  for (int a = 0; a < Q27_QPG; a++) {
+    const long ob = ((long)t * Q27_AQ + hk * Q27_GQA + a) * NS + sp;
+    if (lane == 0) {
+      PM[ob] = m[a];
+      PL[ob] = l[a];
+    }
+    for (int i = 0; i < 16; i++) PO[ob * 256 + i * 16 + lane] = o[a][i];
+  }
+}
