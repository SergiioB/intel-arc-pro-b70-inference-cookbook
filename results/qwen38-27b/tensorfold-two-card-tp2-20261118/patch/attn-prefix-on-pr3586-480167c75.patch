 zig/kernels/xpu/qwen27/decode.cl        |  22 ++-
 zig/kernels/xpu/qwen27/decode_prefix.cl | 185 ++++++++++++++++++++++++
 zig/src/xpu/dev.zig                     |   4 +
 zig/src/xpu/forward.zig                 |  25 +++-
 zig/src/xpu/qwen27.zig                  |  10 +-
 5 files changed, 239 insertions(+), 7 deletions(-)
 create mode 100644 zig/kernels/xpu/qwen27/decode_prefix.cl

diff --git a/zig/kernels/xpu/qwen27/decode.cl b/zig/kernels/xpu/qwen27/decode.cl
index 28786673a..e6559af31 100644
--- a/zig/kernels/xpu/qwen27/decode.cl
+++ b/zig/kernels/xpu/qwen27/decode.cl
@@ -74,9 +74,14 @@ KERNEL(16) void gdn_step(global const ushort *Q, global const ushort *K, global
 
 // Decode attention by key slices: one subgroup per (slice, K/V head, query part, row). Grid y is AKV * QPARTS.
 #define SPLIT 32
-KERNEL(16) void attn_decode(global const ushort *Q, global const ushort *KC, global const ushort *VC, global float *PM,
-                            global float *PL, global float *PO, int p0, int NS, float scale, global const int *TREE,
-                            global const ulong *MT, global const int *POS, int cap) {
+// XPU_ATTN_PREF: the row at pos takes its keys below pref_base(pos, CH) from attn_pref's chunks, cut by position.
+#define PREW 16
+#define PREMIN 1024 // rows below PREMIN + PREW keep the slices alone
+static inline int pref_base(int pos, int CH) { return pos < PREMIN + PREW ? 0 : ((pos - PREW) / CH) * CH; }
+// The slices of attn_decode (PRE 0) and of attn_tail (PRE: the chunk size, slices start at the row's pref_base).
+static inline void attn_slices(global const ushort *Q, global const ushort *KC, global const ushort *VC, global float *PM,
+                               global float *PL, global float *PO, int p0, int NS, float scale, global const int *TREE,
+                               global const ulong *MT, global const int *POS, int cap, int PRE) {
   // MT (if non-null): several streams, one row each; with TREE, tree windows; cap > 0: int8 cache (256 bytes per row).
 #if Q27_QPARTS == 1
   const int sp = get_group_id(0), hk = get_group_id(1), t = get_group_id(2), lane = get_sub_group_local_id();
@@ -91,7 +96,8 @@ KERNEL(16) void attn_decode(global const ushort *Q, global const ushort *KC, glo
     wf = (int)MT[t * 8 + 6];
     base = TREE ? POS[wf] : 0x7fffffff;
   }
-  const int last = MT ? POS[t] : p0 + DEPTH(t), j0 = sp * SPLIT, j1 = min(j0 + SPLIT, last + 1);
+  const int last = MT ? POS[t] : p0 + DEPTH(t), j0 = sp * SPLIT + (PRE ? pref_base(last, PRE) : 0), j1 = min(j0 + SPLIT, last + 1);
+  if (PRE && j0 > last) return;                         // attn_merge2 reads only the slices a row used
   float q[Q27_QPG][16], o[Q27_QPG][16], m[Q27_QPG], l[Q27_QPG];
   for (int a = 0; a < Q27_QPG; a++) {
     for (int i = 0; i < 16; i++) {
@@ -148,6 +154,12 @@ KERNEL(16) void attn_decode(global const ushort *Q, global const ushort *KC, glo
   }
 }
 
+KERNEL(16) void attn_decode(global const ushort *Q, global const ushort *KC, global const ushort *VC, global float *PM,
+                            global float *PL, global float *PO, int p0, int NS, float scale, global const int *TREE,
+                            global const ulong *MT, global const int *POS, int cap) {
+  attn_slices(Q, KC, VC, PM, PL, PO, p0, NS, scale, TREE, MT, POS, cap, 0);
+}
+
 // Merge of the slices, in order: O bf16 [T, Q27_AQ, 256]. One subgroup per (head, row).
 KERNEL(16) void attn_merge(global const float *PM, global const float *PL, global const float *PO, global ushort *O,
                            int p0, int NS, global const int *TREE, global const int *POS) {
@@ -514,3 +526,5 @@ kernel void attn_prompt8(global const ushort *Q, global const char *KC, global c
     }
 }
 #endif // Q27_GQA == 6
+
+#include "decode_prefix.cl"
diff --git a/zig/kernels/xpu/qwen27/decode_prefix.cl b/zig/kernels/xpu/qwen27/decode_prefix.cl
new file mode 100644
index 000000000..085c77d3d
--- /dev/null
+++ b/zig/kernels/xpu/qwen27/decode_prefix.cl
@@ -0,0 +1,185 @@
+// Qwen3.8-27B decode attention with XPU_ATTN_PREF: attn_pref, attn_tail and attn_merge2. Included by decode.cl.
+#if Q27_GQA == 6
+#pragma OPENCL EXTENSION cl_intel_subgroups_short : enable
+// The committed prefix on bf16 DPAS: a subgroup per (tile of 8 queries, K/V head, chunk of CH keys), P in bf16.
+KERNEL(16) void attn_pref(global const ushort *Q, global const ushort *KC, global const ushort *VC, global float *PMP,
+                          global float *PLP, global float *POP, int T, int NCH, int CH, float scale,
+                          global const ulong *MT, global const int *POS) {
+  // Query f = tile * 8 + r is row f / 6, head f % 6; with MT, one row a tile over its own cache and prefix.
+  local short qa[16 * 16 * 8];                            // [dim block][lane][query of the tile]
+  const int tile = get_group_id(0), hk = get_group_id(1), c = get_group_id(2), lane = get_sub_group_local_id();
+  if (MT) {
+    if ((c + 1) * CH > pref_base(POS[tile], CH)) return;
+    KC = (global const ushort *)MT[tile * 8];
+    VC = (global const ushort *)MT[tile * 8 + 1];
+  }
+  for (int i = lane; i < 16 * 16 * 8; i += 16) {
+    const int tb = i >> 7, l = (i >> 3) & 15, r = i & 7, f = tile * 8 + r;
+    const int row = MT ? tile : f / Q27_GQA, a = MT ? r : f % Q27_GQA;
+    qa[i] = row < T && a < Q27_GQA ? (short)Q[((long)row * Q27_AQ + hk * Q27_GQA + a) * 256 + tb * 16 + l] : (short)0;
+  }
+  barrier(CLK_LOCAL_MEM_FENCE);
+  float m[8], ll[8];
+  float8 acc[16];
+  for (int i = 0; i < 8; i++) {
+    m[i] = -INFINITY;
+    ll[i] = 0.0f;
+  }
+  for (int j = 0; j < 16; j++) acc[j] = (float8)(0.0f);
+  const long k0 = (long)c * CH;
+  for (int u = 0; u < CH / 16; u++) {
+    const global uint *krow = (const global uint *)(KC + ((k0 + u * 16 + lane) * Q27_AKV + hk) * 256);
+    float8 s = (float8)(0.0f);
+    __attribute__((opencl_unroll_hint))
+    for (int tb = 0; tb < 16; tb++)
+      s = intel_sub_group_bf16_bf16_matrix_mad_k16(vload8(tb * 16 + lane, qa), as_int8(vload8(0, krow + tb * 8)), s);
+    short8 own;
+    float8 al;
+    __attribute__((opencl_unroll_hint))
+    for (int i = 0; i < 8; i++) {
+      const float x = s[i] * scale;
+      const float mn = fmax(m[i], sub_group_reduce_max(x));
+      const float p = bf2f(f2bf(exp(x - mn)));
+      al[i] = exp(m[i] - mn);
+      ll[i] = ll[i] * al[i] + sub_group_reduce_add(p);
+      own[i] = (short)f2bf(p);
+      m[i] = mn;
+    }
+    __attribute__((opencl_unroll_hint))
+    for (int hb = 0; hb < 4; hb++) {
+      ushort4 vv[16];
+      __attribute__((opencl_unroll_hint))
+      for (int k = 0; k < 16; k++)
+        vv[k] = intel_sub_group_block_read_us4(VC + ((k0 + u * 16 + k) * Q27_AKV + hk) * 256 + hb * 64);
+      __attribute__((opencl_unroll_hint))
+      for (int e = 0; e < 4; e++) {
+        int8 b;
+        __attribute__((opencl_unroll_hint))
+        for (int d = 0; d < 8; d++) b[d] = (int)vv[2 * d][e] | ((int)vv[2 * d + 1][e] << 16);
+        acc[hb * 4 + e] = intel_sub_group_bf16_bf16_matrix_mad_k16(own, b, acc[hb * 4 + e] * al);
+      }
+    }
+  }
+  for (int i = 0; i < 8; i++) {
+    const int f = tile * 8 + i, row = MT ? tile : f / Q27_GQA, a = MT ? i : f % Q27_GQA;
+    if (row >= T || a >= Q27_GQA) break;
+    const long base = ((long)row * Q27_AQ + hk * Q27_GQA + a) * NCH + c;
+    if (lane == 0) {
+      PMP[base] = m[i];
+      PLP[base] = ll[i];
+    }
+    for (int j = 0; j < 16; j++) POP[base * 256 + j * 16 + lane] = acc[j][i];
+  }
+}
+
+#pragma OPENCL EXTENSION cl_intel_subgroups_char : enable
+// attn_pref over the int8 cache: K and V rows widen to bf16 exactly, their scales fold into the score and into P.
+KERNEL(16) void attn_pref8(global const ushort *Q, global const char *KC, global const char *VC, global float *PMP,
+                           global float *PLP, global float *POP, int T, int NCH, int CH, float scale,
+                           global const ulong *MT, global const int *POS, int cap) {
+  local short qa[16 * 16 * 8];                            // [dim block][lane][query of the tile]
+  const int tile = get_group_id(0), hk = get_group_id(1), c = get_group_id(2), lane = get_sub_group_local_id();
+  if (MT) {
+    if ((c + 1) * CH > pref_base(POS[tile], CH)) return;
+    KC = (global const char *)MT[tile * 8];
+    VC = (global const char *)MT[tile * 8 + 1];
+  }
+  global const float *KS = (global const float *)(KC + (long)cap * Q27_KVROW);
+  global const float *VS = (global const float *)(VC + (long)cap * Q27_KVROW);
+  for (int i = lane; i < 16 * 16 * 8; i += 16) {
+    const int tb = i >> 7, l = (i >> 3) & 15, r = i & 7, f = tile * 8 + r;
+    const int row = MT ? tile : f / Q27_GQA, a = MT ? r : f % Q27_GQA;
+    qa[i] = row < T && a < Q27_GQA ? (short)Q[((long)row * Q27_AQ + hk * Q27_GQA + a) * 256 + tb * 16 + l] : (short)0;
+  }
+  barrier(CLK_LOCAL_MEM_FENCE);
+  float m[8], ll[8];
+  float8 acc[16];
+  for (int i = 0; i < 8; i++) {
+    m[i] = -INFINITY;
+    ll[i] = 0.0f;
+  }
+  for (int j = 0; j < 16; j++) acc[j] = (float8)(0.0f);
+  const long k0 = (long)c * CH;
+  for (int u = 0; u < CH / 16; u++) {
+    const long key = (k0 + u * 16 + lane) * Q27_AKV + hk; // the lane's key
+    const global char *krow = KC + key * 256;
+    const float ks = KS[key] * scale, vs = VS[key];
+    float8 s = (float8)(0.0f);
+    __attribute__((opencl_unroll_hint))
+    for (int tb = 0; tb < 16; tb++) {
+      const uint16 kf = as_uint16(convert_float16(vload16(tb, krow))); // an int8 is exact in bf16: its top 16 bits
+      s = intel_sub_group_bf16_bf16_matrix_mad_k16(vload8(tb * 16 + lane, qa), as_int8((kf.even >> 16) | (kf.odd & 0xFFFF0000u)), s);
+    }
+    short8 own;
+    float8 al;
+    __attribute__((opencl_unroll_hint))
+    for (int i = 0; i < 8; i++) {
+      const float x = s[i] * ks;
+      const float mn = fmax(m[i], sub_group_reduce_max(x));
+      const float p = bf2f(f2bf(exp(x - mn)));
+      al[i] = exp(m[i] - mn);
+      ll[i] = ll[i] * al[i] + sub_group_reduce_add(p);
+      own[i] = (short)f2bf(p * vs);
+      m[i] = mn;
+    }
+    __attribute__((opencl_unroll_hint))
+    for (int hb = 0; hb < 4; hb++) {
+      uint4 vv[16];                                       // key k: 4 blocks of 16 dims, the lane's dim of each, as bf16
+      __attribute__((opencl_unroll_hint))
+      for (int k = 0; k < 16; k++) {
+        const uchar4 raw = intel_sub_group_block_read_uc4((global const uchar *)VC + ((k0 + u * 16 + k) * Q27_AKV + hk) * 256 + hb * 64);
+        vv[k] = as_uint4(convert_float4(as_char4(raw))) >> 16;
+      }
+      __attribute__((opencl_unroll_hint))
+      for (int e = 0; e < 4; e++) {
+        int8 b;
+        __attribute__((opencl_unroll_hint))
+        for (int d = 0; d < 8; d++) b[d] = (int)(vv[2 * d][e] | (vv[2 * d + 1][e] << 16));
+        acc[hb * 4 + e] = intel_sub_group_bf16_bf16_matrix_mad_k16(own, b, acc[hb * 4 + e] * al);
+      }
+    }
+  }
+  for (int i = 0; i < 8; i++) {
+    const int f = tile * 8 + i, row = MT ? tile : f / Q27_GQA, a = MT ? i : f % Q27_GQA;
+    if (row >= T || a >= Q27_GQA) break;
+    const long base = ((long)row * Q27_AQ + hk * Q27_GQA + a) * NCH + c;
+    if (lane == 0) {
+      PMP[base] = m[i];
+      PLP[base] = ll[i];
+    }
+    for (int j = 0; j < 16; j++) POP[base * 256 + j * 16 + lane] = acc[j][i];
+  }
+}
+
+// A row's slices past its prefix: attn_decode's arithmetic from pref_base on.
+KERNEL(16) void attn_tail(global const ushort *Q, global const ushort *KC, global const ushort *VC, global float *PM,
+                          global float *PL, global float *PO, int p0, int NS, float scale, global const int *TREE,
+                          global const ulong *MT, global const int *POS, int cap, int PRE) {
+  attn_slices(Q, KC, VC, PM, PL, PO, p0, NS, scale, TREE, MT, POS, cap, PRE);
+}
+
+// Merge of a row's prefix chunks then its slices, in order: O bf16 [T, Q27_AQ, 256]. One subgroup per (head, row).
+KERNEL(16) void attn_merge2(global const float *PMP, global const float *PLP, global const float *POP,
+                            global const float *PM, global const float *PL, global const float *PO, global ushort *O,
+                            int p0, int NCH, int CH, int NS, global const int *TREE, global const int *POS) {
+  const int hh = get_group_id(0), t = get_group_id(1), lane = get_sub_group_local_id();
+  const int last = POS ? POS[t] : p0 + DEPTH(t), pb = pref_base(last, CH), nc = pb / CH, used = (last - pb) / SPLIT + 1;
+  const long bp = ((long)t * Q27_AQ + hh) * NCH, base = ((long)t * Q27_AQ + hh) * NS;
+  float m = -INFINITY;
+  for (int s = 0; s < nc; s++) m = fmax(m, PMP[bp + s]);
+  for (int s = 0; s < used; s++) m = fmax(m, PM[base + s]);
+  float l = 0.0f, o[16];
+  for (int i = 0; i < 16; i++) o[i] = 0.0f;
+  for (int s = 0; s < nc; s++) {
+    const float w = exp(PMP[bp + s] - m);
+    l += PLP[bp + s] * w;
+    for (int i = 0; i < 16; i++) o[i] += POP[(bp + s) * 256 + i * 16 + lane] * w;
+  }
+  for (int s = 0; s < used; s++) {
+    const float w = exp(PM[base + s] - m);
+    l += PL[base + s] * w;
+    for (int i = 0; i < 16; i++) o[i] += PO[(base + s) * 256 + i * 16 + lane] * w;
+  }
+  for (int i = 0; i < 16; i++) O[((long)t * Q27_AQ + hh) * 256 + i * 16 + lane] = f2bf(o[i] / l);
+}
+#endif
